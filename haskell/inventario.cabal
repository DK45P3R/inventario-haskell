cabal-version: 2.4
name:          inventario
version:       2.0.0
synopsis:      Sistema de Gerenciamento de Inventário em Haskell
description:
  Sistema interativo de inventário via terminal.
  Demonstra programação funcional com separação entre lógica pura e I/O,
  tipos algébricos (AcaoLog, StatusLog, LogEntry), Map como estrutura de dados,
  persistência em disco e log de auditoria append-only.
author:        Trabalho Programação Funcional
license:       MIT

executable inventario
  main-is:          Main.hs
  other-modules:    Inventario
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -Wall -Wno-unused-do-bind
  build-depends:
      base       >= 4.14
    , containers >= 0.6
    , time       >= 1.9
    , directory  >= 1.3
